# HostDeck 1.4.0 — use somente no backend local. Nunca use NEXT_PUBLIC_ para secrets.

# Square Cloud
SQUARECLOUD_API_KEY=

# Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Render
RENDER_API_KEY=

# Netlify
NETLIFY_TOKEN=

# Cloudflare Pages
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# DigitalOcean App Platform
DIGITALOCEAN_TOKEN=

# Heroku
HEROKU_API_KEY=

# Gemini Intelligence
GEMINI_API_KEY=
